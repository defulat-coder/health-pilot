{
  "name": "health-pilot-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "Health Pilot WeChat Mini Program frontend",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tarojs/router": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "@nutui/nutui-react-taro": "^3.0.0",
    "axios-miniprogram": "^1.0.0",
    "jotai": "^2.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tarojs-router-next": "^3.4.6",
    "tdesign-mobile-react": "^0.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tarojs/cli": "^4.0.0",
    "eslint-config-taro": "^4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
