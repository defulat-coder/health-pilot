    "@tarojs/shared": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@reduxjs/toolkit": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tarojs/router": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@nutui/nutui-react-taro": "^3.0.0",
    "axios-miniprogram": "^1.0.0",
    "jotai": "^2.0.0",
    "react": "^18.0.0",
